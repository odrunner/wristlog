<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:wrotate.com</string>
		<string>applinks:api.wrotate.com</string>
		<!-- Email click-tracking redirect host. SES click tracking rewrites every
		     href in outgoing mail, and iOS matches Universal Links on the INITIAL
		     URL's host — it does not re-evaluate after the redirect lands on
		     wrotate.com. Without this entry a tracked link opens Safari instead of
		     the app, which is why click tracking is currently DISABLED in SES.
		     Listing a host that serves no AASA is harmless: iOS simply fails to
		     associate it. Before re-enabling CLICK in SES, click.wrotate.com must
		     serve a valid AASA over HTTPS (CloudFront + ACM in front of
		     r.us-west-2.awstrack.me, forwarding the Host header). -->
		<string>applinks:click.wrotate.com</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.wrotate.Wrotate</string>
	</array>
</dict>
</plist>
