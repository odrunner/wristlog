<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility (targetSdk 30+): lets the file chooser resolve a camera app. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".WrotateApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="WRotate"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <!-- The shell is the launcher: a WebView over live wrotate.com. configChanges keeps the
             activity (and its capture thread) alive across rotation/ui changes mid-measurement. -->
        <activity
            android:name=".ShellActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OAuth Custom Tab return: wrotate://auth-callback#access_token=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wrotate" android:host="auth-callback" />
            </intent-filter>
            <!-- App links: https://wrotate.com opens the app once Android verifies
                 /.well-known/assetlinks.json (Play App Signing fingerprints). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="wrotate.com" />
                <data android:host="www.wrotate.com" />
            </intent-filter>
            <!-- Launcher shortcuts land here as wrotate://quick/<action>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="wrotate" android:host="quick" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Shortcut trampoline: static shortcuts launch with NEW_TASK|CLEAR_TASK, which aimed at
             ShellActivity would destroy a running session on every warm tap. This owns its own
             task, absorbs the clear, and re-enters the shell via onNewIntent. -->
        <activity
            android:name=".QuickActionActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Share target: receive an image from any app, park it, open the shell (iOS share
             extension parity). Translucent so the share sheet hands straight to the shell. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- Kept for engine debugging; reachable via `adb shell am start`, no longer the launcher. -->
        <activity
            android:name=".HarnessActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <!-- System-displayed (background) notifications: without these they land in FCM's
             "Miscellaneous" fallback channel and use the full-colour launcher icon as the
             status-bar glyph. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reminders" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_shortcut_measure" />
        <!-- FCM deliveries (push plan). Token registration lives in PushRegistrar. -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name=".LogProvider"
            android:authorities="com.wrotate.app.logs"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Camera-capture temp files handed to the WebView file chooser. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.wrotate.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
