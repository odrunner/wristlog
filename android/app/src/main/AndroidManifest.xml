<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:label="WRotate"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <!-- configChanges: a rotation must not recreate the activity mid-session (the
             capture thread and core belong to this instance). -->
        <activity
            android:name=".HarnessActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".LogProvider"
            android:authorities="com.wrotate.app.logs"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
